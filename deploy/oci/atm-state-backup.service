[Unit]
Description=ATM allowlisted durable state backup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/atm/state-backup.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/atm/state-backup.env
ExecStart=/opt/atm/scripts/atm-state-backup.sh backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atm /run
ProtectHome=true
