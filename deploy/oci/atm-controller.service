[Unit]
Description=ATM GitHub control bus (OCI canonical controller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/atm
Environment=ATM_HOST_CLASS=OCI
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/atm/control.env
ExecStart=/opt/atm/.venv/bin/python /opt/atm/src/atm_control_oci.py
Restart=always
RestartSec=15s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atm /run /etc/atm
ProtectHome=true

[Install]
WantedBy=multi-user.target
