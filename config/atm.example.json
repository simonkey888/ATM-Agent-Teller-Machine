{
  "target_paid_usd": 200,
  "min_reward_usd": 50,
  "ideal_reward_usd": 200,
  "max_task_hours": 12,
  "max_competition": 8,
  "dry_run": false,
  "allow_auto_claim": true,
  "allow_auto_pr": true,
  "payment_recipient_public_identifier": "",
  "provider": {
    "primary": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "requires_env": "GOOGLE_API_KEY",
      "enabled": true
    },
    "fallbacks": []
  },
  "provider_runtime": {
    "default_429_circuit_seconds": 900
  },
  "opportunity_adapters": {
    "workprotocol": {
      "enabled": true,
      "base_url": "https://workprotocol.ai"
    },
    "taskmarket": {
      "enabled": true,
      "base_url": "https://api.taskmarket.dev"
    },
    "algora": {
      "enabled": false,
      "payout_api_template": null
    },
    "opire": {
      "enabled": false
    },
    "moltjobs": {
      "enabled": false
    }
  },
  "discovery_order": [
    "workprotocol",
    "taskmarket",
    "algora",
    "opire",
    "moltjobs"
  ],
  "hermes": {
    "max_turns": 500,
    "process_timeout_seconds": 7200
  },
  "loop": {
    "failure_backoff_seconds": 30,
    "max_failure_backoff_seconds": 1800,
    "phase_delay_seconds": {
      "DISCOVER": 60,
      "VERIFY": 2,
      "CLAIM": 2,
      "WORK": 2,
      "CHECK": 2,
      "SUBMIT": 2,
      "MONITOR": 300,
      "PAYMENT_VERIFY": 30
    }
  }
}
